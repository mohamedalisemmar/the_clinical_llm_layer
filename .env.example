# Copy this file to .env and fill it in.

# Which LLM backend to use: mock | anthropic | openai
#   mock      -> offline simulator, no API key, for development and demos only
#   anthropic -> Claude models (needs ANTHROPIC_API_KEY)
#   openai    -> any OpenAI-compatible API: OpenAI, Groq, OpenRouter, or a local Ollama server
LLM_PROVIDER=mock

# Model name (leave empty for the provider default)
#   anthropic default: claude-haiku-4-5-20251001
#   openai default:    gpt-4o-mini
#   Ollama example:    llama3.1:8b
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# For Ollama (free, local):  OPENAI_BASE_URL=http://localhost:11434/v1  and  OPENAI_API_KEY=ollama
# For Groq:                  OPENAI_BASE_URL=https://api.groq.com/openai/v1
# For OpenRouter:            OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=

# Reliability layer settings
N_SAMPLES=5                  # repeated generations for the consistency signal
SAMPLE_TEMPERATURE=1.0       # temperature for repeated generations
BASELINE_TEMPERATURE=0.7     # temperature for the answer shown to the clinician
USE_LLM_CONTRADICTION_CHECK=true
USE_LLM_JUDGE=true
USE_LLM_EQUIVALENCE=true

# Study session: limit cases per block (0 = all cases in the set)
MAX_CASES_PER_BLOCK=0

# Cost estimate for the lightweight analysis (USD per million tokens, check your provider's price page)
PRICE_INPUT_PER_MTOK=1.0
PRICE_OUTPUT_PER_MTOK=5.0
